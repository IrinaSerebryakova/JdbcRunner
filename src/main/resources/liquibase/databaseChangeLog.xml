<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">
    <changeSet id="1" author="IrinaSerebryakova">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="passenger"/>
            </not>
        </preConditions>
        <createTable tableName="passenger">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="passenger_pkey"/>
            </column>
            <column name="first_name" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="2" author="IrinaSerebryakova">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="train"/>
            </not>
        </preConditions>
        <createTable tableName="train">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="train_pkey"/>
            </column>
            <column name="number" type="varchar">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="train_name" type="varchar">
                <constraints nullable="false"/>
            </column>
            <column name="town_from" type="varchar">
                <constraints nullable="false"/>
            </column>
            <column name="time_out" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="town_to" type="varchar">
                <constraints nullable="false"/>
            </column>
            <column name="time_in" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="3" author="IrinaSerebryakova">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="town"/>
            </not>
        </preConditions>
        <createTable tableName="town">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="town_pkey"/>
            </column>
            <column name="town_name" type="varchar">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="4" author="IrinaSerebryakova">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="pass_in_trip"/>
            </not>
        </preConditions>
        <createTable tableName="pass_in_trip">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="pass_in_trip_pkey"/>
            </column>
            <column name="pass_name" type="varchar"/>
            <column name="train_number" type="varchar"/>
            <column name="seat_number" type="varchar"/>
        </createTable>
    </changeSet>
